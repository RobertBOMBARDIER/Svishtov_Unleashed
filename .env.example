# ============================================================
# Svishtov Tourist Guide — Backend Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# On Railway, set these via the Dashboard → Environment Variables.
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL (provided automatically by Railway PostgreSQL plugin)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/svishtov_db

# ── JWT Authentication ────────────────────────────────────────────────────────
# Secret key used to sign JWT tokens — use a long random string (≥ 32 chars)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_secret_key

# JWT algorithm (HS256 recommended)
JWT_ALGORITHM=HS256

# Access token expiry in minutes (default: 60 minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token expiry in days (default: 30 days)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Photo Storage ─────────────────────────────────────────────────────────────
# Primary: Railway Persistent Volume mount path
STORAGE_PATH=/data/photos

# Thumbnail subdirectory (relative to STORAGE_PATH)
THUMBNAIL_SUBDIR=thumbnails

# Maximum upload size in bytes (default: 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# ── Cloudflare R2 (fallback storage) ─────────────────────────────────────────
# Set USE_R2_STORAGE=true to use Cloudflare R2 instead of local volume
USE_R2_STORAGE=false

R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=svishtov-photos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev

# ── Application ───────────────────────────────────────────────────────────────
# Environment: development | production
APP_ENV=development

# CORS allowed origins (comma-separated, or * for all)
CORS_ORIGINS=http://localhost:3000,https://svishtov-api.up.railway.app

# Base URL of the deployed API (used for generating photo URLs)
API_BASE_URL=https://svishtov-api.up.railway.app

# ── Email (password reset) ────────────────────────────────────────────────────
# SMTP settings for sending password reset emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
EMAIL_FROM=noreply@svishtov-guide.app

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
