# ============================================================
# Svishtov Tourist Guide — Backend Environment Variables
# Development / local configuration
# ============================================================

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite pentru development local (nu necesită PostgreSQL instalat)
DATABASE_URL=sqlite+aiosqlite:///./svishtov_dev.db

# ── JWT Authentication ────────────────────────────────────────────────────────
JWT_SECRET=dev_secret_key_change_in_production_32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Photo Storage ─────────────────────────────────────────────────────────────
STORAGE_PATH=./data/photos
THUMBNAIL_SUBDIR=thumbnails
MAX_UPLOAD_SIZE_BYTES=10485760

# ── Cloudflare R2 (dezactivat în development) ────────────────────────────────
USE_R2_STORAGE=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=*
API_BASE_URL=http://localhost:8000

# ── Email (dezactivat în development) ────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
